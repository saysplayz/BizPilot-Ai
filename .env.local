# Supabase project (Project Settings → API). The anon/publishable key is safe in
# the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://ncnpzvldhbbfkgkghluh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_lDntl6jkR-NQruD-0EXByQ_P7b5Oij0

# Public URL of the app (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI assistant (optional). Server-side only — never prefix with NEXT_PUBLIC_.
# Without a key the assistant still answers common questions with BizPilot's 
# built-in calculator, and says that AI explanations are not configured.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# NOTE: the app does NOT need a Supabase service-role key. Do not add one.
GEMINI_API_KEY=AQ.Ab8RN6INCSX570T2rjMsr8QOClxVRa93Qj2eixs4rtgEEcKnkA